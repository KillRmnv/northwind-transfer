DB_PROFILE=postgres

DB_HOST=db
DB_PORT=5432
DB_NAME=transfer
DB_USER=transfer
DB_PASSWORD=transfer

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

SQLITE_PATH=./var/transfer.sqlite3
DATA_DIR=./data

PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_TEMP_BUFFERS=16MB
PG_WAL_BUFFERS=16MB
PG_MAX_CONNECTIONS=100
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200

DB_PORT_HOST=5433

MOCK_PROVIDER_URL=http://mock-provider:9000
MOCK_PROVIDER_TIMEOUT_SEC=5.0
PROVIDER_PROBE_DELAY_SEC=2.0
PROVIDER_VISIBILITY_GRACE_SEC=30
MOCK_MODE=normal
MOCK_SEED=1
MOCK_SCENARIO=ok
MOCK_SLOW_SEC=30
MOCK_SETTLE_SEC=2
MOCK_HANG_SEC=35

PROVIDER_WEBHOOK_SECRET=local-dev-webhook-secret

API_SYNC_TIMEOUT_SEC=12
RECONCILE_INTERVAL_SEC=60
LOG_LEVEL=INFO
ENV=dev
